{
  "name": "allsessions",
  "version": "0.0.14",
  "description": "A local-first Tauri desktop app for browsing Codex, Claude Code, and Gemini CLI session history.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "yuluo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuluod/AllSessions.git"
  },
  "homepage": "https://github.com/yuluod/AllSessions#readme",
  "bugs": {
    "url": "https://github.com/yuluod/AllSessions/issues"
  },
  "packageManager": "pnpm@11.10.0",
  "keywords": [
    "ai",
    "codex",
    "session",
    "viewer",
    "local",
    "cli",
    "claude",
    "gemini"
  ],
  "scripts": {
    "dev": "tauri dev",
    "test": "node --test",
    "lint": "eslint public test scripts",
    "lint:fix": "eslint public test scripts --fix",
    "format": "prettier --write .",
    "build": "vite build",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:build": "pnpm desktop:build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5",
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.10.0"
  }
}
