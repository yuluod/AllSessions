{
  "name": "allsessions",
  "version": "0.2.6",
  "description": "A local-first Tauri desktop app for browsing Codex, Claude Code, Gemini CLI, Pi, Kimi Code CLI, OpenCode, Kilo, ZCode, Cursor, and Devin session history.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "yuluo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuluod/AllSessions.git"
  },
  "homepage": "https://github.com/yuluod/AllSessions#readme",
  "bugs": {
    "url": "https://github.com/yuluod/AllSessions/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "keywords": [
    "ai",
    "codex",
    "session",
    "viewer",
    "local",
    "cli",
    "claude",
    "gemini",
    "pi",
    "kimi",
    "opencode",
    "kilo"
  ],
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite --host 127.0.0.1 --port 3210 --strictPort",
    "test": "node --test",
    "lint": "eslint public test scripts",
    "lint:fix": "eslint public test scripts --fix",
    "format": "prettier --write .",
    "build": "vite build",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "release:prepare": "node scripts/prepare-release.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:clean": "cargo sweep --time 14 src-tauri",
    "release:build": "pnpm desktop:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2"
  }
}
