{
  "name": "allsessions",
  "version": "0.0.24",
  "description": "A local-first Tauri desktop app for browsing Codex, Claude Code, Gemini CLI, Pi, Kimi Code CLI, and OpenCode session history.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "yuluo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuluod/AllSessions.git"
  },
  "homepage": "https://github.com/yuluod/AllSessions#readme",
  "bugs": {
    "url": "https://github.com/yuluod/AllSessions/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "ai",
    "codex",
    "session",
    "viewer",
    "local",
    "cli",
    "claude",
    "gemini",
    "pi",
    "kimi",
    "opencode"
  ],
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite --host 127.0.0.1 --port 3210 --strictPort",
    "test": "node --test",
    "lint": "eslint public test scripts",
    "lint:fix": "eslint public test scripts --fix",
    "format": "prettier --write .",
    "build": "vite build",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:build": "pnpm desktop:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.10.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4"
  }
}
