{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AllSessions 主窗口的最小权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/yuluod/AllSessions" },
        {
          "url": "https://github.com/yuluod/AllSessions/blob/main/LICENSE"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
