{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllSessions",
  "version": "../package.json",
  "identifier": "com.yuluod.allsessions",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AllSessions",
        "url": "loading.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "本地 AI 会话工作台",
    "externalBin": ["binaries/node"],
    "resources": {
      "../server/": "server/",
      "../public/": "public/",
      "../package.json": "package.json",
      "../CHANGELOG.md": "CHANGELOG.md",
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
